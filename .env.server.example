# Copy to .env.server on the server. Never commit the real file.
PORT=8080
PUBLIC_ORIGIN=https://jersey-3d-configurator.jason1064969838.workers.dev
TRUST_PROXY=true
DATA_DIR=/data
DIST_DIR=/app/dist
LOCAL_PRODUCTION_FILES=false
JERSEY_DATA_PATH=/opt/jersey-data

# Generate these with: npm run admin:credentials
# Save the displayed login password in a password manager, not in this file.
# Default shop shown after login. It must also exist in SHOPIFY_STORE_CONFIG_JSON.
ADMIN_SHOP=example.myshopify.com
ADMIN_PASSWORD_HASH=CHANGE_ME_WITH_GENERATED_SCRYPT_HASH
ADMIN_SESSION_SECRET=CHANGE_ME_WITH_GENERATED_RANDOM_SECRET

# Keep the JSON on one line. Every top-level shop becomes an allowed shop in the
# admin selector. Replace every example shop and variant ID with real values.
SHOPIFY_STORE_CONFIG_JSON={"example.myshopify.com":{"productId":"fn8788-jersey","currency":"USD","jerseyVariants":{"s":"123456789"},"surchargeVariants":{"8":"987654321"}},"second-shop.myshopify.com":{"productId":"fn8788-jersey","currency":"USD","jerseyVariants":{"s":"223456789"},"surchargeVariants":{"8":"287654321"}}}

# Enter these only in the server's private .env.server file.
SHOPIFY_API_KEY=CHANGE_ME_WITH_PUBLIC_APP_CLIENT_ID
SHOPIFY_API_SECRET=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
# Generate exactly 32 random bytes and store them as standard base64.
SHOPIFY_TOKEN_ENCRYPTION_KEY=CHANGE_ME_WITH_BASE64_ENCODED_32_BYTE_KEY
CART_QUOTE_SIGNING_SECRET=CHANGE_ME_WITH_RANDOM_32_PLUS_CHARACTERS
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_CHARACTERS
