{% assign configured_product_handle = section.settings.product_handle | default: 'custom-3d-football-jersey' %}
{% if product and section.settings.enabled and product.handle == configured_product_handle %}
  {% assign surcharge_product = all_products['3d-customization-surcharge'] %}
  {% assign initial_variant = product.selected_or_first_available_variant %}
  {% capture variant_map %}
    {
      {% for variant in product.variants %}
        {{ variant.option1 | downcase | json }}: {{ variant.id | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  {% endcapture %}
  {% capture surcharge_variant_map %}
    {
      {% for variant in surcharge_product.variants %}
        {{ variant.option1 | json }}: {{ variant.id | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  {% endcapture %}
  {% capture configurator_url %}https://139.199.202.173/?shop={{ shop.permanent_domain | url_encode }}&productHandle={{ product.handle | url_encode }}&variantId={{ initial_variant.id }}&variantMap={{ variant_map | strip | url_encode }}&surchargeVariantMap={{ surcharge_variant_map | strip | url_encode }}&returnPath={{ routes.cart_url | url_encode }}{% endcapture %}

  <style>
    .product-3d-configurator-launch {
      width: 100%;
      margin: 20px 0 16px;
    }

    .product-3d-configurator-launch .button {
      width: 100%;
      justify-content: center;
    }
  </style>
  <div
    class="product-3d-configurator-launch"
    data-product-3d-configurator-launch
    data-initial-variant-id="{{ initial_variant.id }}"
    data-surcharge-variant-map="{{ surcharge_variant_map | strip | escape }}"
    data-variant-map="{{ variant_map | strip | escape }}"
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product-handle="{{ product.handle | escape }}"
    data-return-path="{{ routes.cart_url | escape }}"
  >
    <a class="button" data-product-3d-configurator-launch-button href="{{ configurator_url | strip | escape }}">
      {{ section.settings.button_label | escape }}
    </a>
  </div>

  <script>
    (() => {
      const launcher = document.querySelector('[data-product-3d-configurator-launch]');
      if (!launcher) return;

      const productForm = document.querySelector('form[action*="/cart/add"]');
      const quantityInput = productForm?.querySelector('[name="quantity"]');
      const addButton = productForm?.querySelector('button[name="add"], button[type="submit"]');

      if (productForm && quantityInput && addButton) {
        let controlsRow = quantityInput;
        while (controlsRow.parentElement && !controlsRow.contains(addButton) && controlsRow.parentElement !== productForm) {
          controlsRow = controlsRow.parentElement;
        }
        (controlsRow.contains(addButton) ? controlsRow : quantityInput).before(launcher);
      } else if (addButton) {
        addButton.before(launcher);
      }

      if (document.documentElement.dataset.pc3dSectionLauncherReady === 'true') return;
      document.documentElement.dataset.pc3dSectionLauncherReady = 'true';

      document.addEventListener('click', (event) => {
        const button = event.target.closest('[data-product-3d-configurator-launch-button]');
        const currentLauncher = button?.closest('[data-product-3d-configurator-launch]');
        if (!currentLauncher) return;
        const details = currentLauncher.closest('[data-testid="product-information-details"]');
        const productForm = currentLauncher.closest('form[action*="/cart/add"]')
          || details?.querySelector('form[action*="/cart/add"]')
          || document.querySelector('form[action*="/cart/add"]');
        const formVariantId = productForm?.elements?.id?.value;
        const selectVariantField = productForm?.querySelector('select[name="id"]');
        const checkedVariantField = productForm?.querySelector('input[name="id"]:checked');
        const hiddenVariantField = productForm?.querySelector('input[type="hidden"][name="id"]');
        const urlVariantId = new URL(window.location.href).searchParams.get('variant');
        const variantId = formVariantId
          || selectVariantField?.value
          || checkedVariantField?.value
          || hiddenVariantField?.value
          || urlVariantId
          || currentLauncher.dataset.initialVariantId;

        if (!variantId) return;

        const variantMap = JSON.parse(currentLauncher.dataset.variantMap);
        const surchargeVariantMap = JSON.parse(currentLauncher.dataset.surchargeVariantMap);
        const workerUrl = new URL('https://139.199.202.173/');
        workerUrl.searchParams.set('shop', currentLauncher.dataset.shop);
        workerUrl.searchParams.set('productHandle', currentLauncher.dataset.productHandle);
        workerUrl.searchParams.set('variantId', variantId);
        workerUrl.searchParams.set('variantMap', JSON.stringify(variantMap));
        workerUrl.searchParams.set('surchargeVariantMap', JSON.stringify(surchargeVariantMap));
        workerUrl.searchParams.set('returnPath', currentLauncher.dataset.returnPath);
        button.href = workerUrl.toString();
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "3D configurator launcher",
  "tag": "section",
  "class": "section-product-3d-configurator-launch",
  "settings": [
    {
      "type": "text",
      "id": "product_handle",
      "label": "Product handle",
      "default": "custom-3d-football-jersey"
    },
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable 3D configurator launcher",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start 3D customization"
    }
  ],
  "presets": [
    {
      "name": "3D configurator launcher"
    }
  ]
}
{% endschema %}
