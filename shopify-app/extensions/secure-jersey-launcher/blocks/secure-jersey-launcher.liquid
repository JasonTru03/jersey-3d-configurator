{% if product %}
  {% assign selected_variant = product.selected_or_first_available_variant %}
  <div
    class="secure-jersey-launcher"
    data-secure-jersey-launcher
    data-initial-variant-id="{{ selected_variant.id }}"
    {{ block.shopify_attributes }}
  >
    <a
      class="secure-jersey-launcher__button"
      data-secure-jersey-launcher-button
      href="{{ routes.root_url }}apps/jersey-configurator/launch?productHandle={{ product.handle | url_encode }}&variantId={{ selected_variant.id }}&returnPath={{ routes.cart_url | url_encode }}"
    >
      {{ block.settings.button_label | escape }}
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "3D jersey configurator",
  "target": "section",
  "stylesheet": "secure-jersey-launcher.css",
  "javascript": "secure-jersey-launcher.js",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start 3D customization"
    }
  ]
}
{% endschema %}
