{% liquid
  assign product_resource = closest.product | default: product
%}

{% if product_resource and block.settings.enabled %}
  {% capture variant_map %}
    {
      {% for variant in product_resource.variants %}
        {{ variant.option1 | downcase | json }}: {{ variant.id | json }}{% unless forloop.last %},{% endunless %}
      {% endfor %}
    }
  {% endcapture %}

  <div
    id="product-3d-configurator-launch-{{ block.id }}"
    class="product-3d-configurator-block"
    data-product-3d-configurator-block
    data-variant-map="{{ variant_map | strip | escape }}"
    data-shop="{{ shop.permanent_domain | escape }}"
    data-product-handle="{{ product_resource.handle | escape }}"
    data-return-path="{{ routes.cart_url | escape }}"
    {{ block.shopify_attributes }}
  >
    <button type="button" class="button" data-product-3d-configurator-button>
      {{ block.settings.button_label | escape }}
    </button>
  </div>

  <script>
    (() => {
      const launcher = document.getElementById('product-3d-configurator-launch-{{ block.id }}');
      if (!launcher || launcher.dataset.ready === 'true') return;
      launcher.dataset.ready = 'true';

      const button = launcher.querySelector('[data-product-3d-configurator-button]');
      const variantMap = JSON.parse(launcher.dataset.variantMap);

      button.addEventListener('click', () => {
        const details = launcher.closest('[data-testid="product-information-details"]');
        const productForm = details?.querySelector('form[action*="/cart/add"]')
          || document.querySelector('form[action*="/cart/add"]');
        const selectVariantField = productForm?.querySelector('select[name="id"]');
        const checkedVariantField = productForm?.querySelector('input[name="id"]:checked');
        const hiddenVariantField = productForm?.querySelector('input[type="hidden"][name="id"]');
        const variantId = selectVariantField?.value || checkedVariantField?.value || hiddenVariantField?.value;

        if (!variantId) return;

        const workerUrl = new URL('https://jersey-3d-configurator.jason1064969838.workers.dev/');
        workerUrl.searchParams.set('shop', launcher.dataset.shop);
        workerUrl.searchParams.set('productHandle', launcher.dataset.productHandle);
        workerUrl.searchParams.set('variantId', variantId);
        workerUrl.searchParams.set('variantMap', JSON.stringify(variantMap));
        workerUrl.searchParams.set('returnPath', launcher.dataset.returnPath);
        window.location.assign(workerUrl.toString());
      });
    })();
  </script>
{% endif %}

{% stylesheet %}
  .product-3d-configurator-block {
    width: 100%;
  }

  .product-3d-configurator-block .button {
    width: 100%;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "3D configurator launcher",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable 3D configurator launcher",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Start 3D customization"
    }
  ],
  "presets": [
    {
      "name": "3D configurator launcher",
      "category": "Product"
    }
  ]
}
{% endschema %}
