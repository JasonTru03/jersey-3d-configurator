{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jersey-3d-configurator",
  "compatibility_date": "2026-07-14",
  "main": "workers/index.js",
  "r2_buckets": [{ "binding": "DESIGN_ASSETS", "bucket_name": "jersey-design-assets" }],
  "kv_namespaces": [{ "binding": "DESIGN_UPLOAD_RATE_LIMIT", "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID" }],
  "vars": { "TURNSTILE_SITE_KEY": "REPLACE_WITH_PUBLIC_TURNSTILE_SITE_KEY" },
  "assets": {
    "directory": "./dist"
  }
}
